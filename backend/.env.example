# gemini (Gemma or Gemini models via Google AI Studio) or groq
LLM_PROVIDER=gemini

# Free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest
# Used when the main model is overloaded, rate-limited or times out.
# gemma-4-31b-it also works here once Google's Gemma service is stable.
GEMINI_FALLBACK_MODEL=gemini-2.5-flash-lite

# Free key: https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_FALLBACK_MODEL=llama-3.1-8b-instant

# Stock photos, tried in this order
UNSPLASH_ACCESS_KEY=
PEXELS_API_KEY=
PIXABAY_API_KEY=
